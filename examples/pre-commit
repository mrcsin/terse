#!/usr/bin/env bash
# Lints the staged content of every staged .cs file, not the working-tree copy.
# Install: copy to .githooks/pre-commit, then: git config core.hooksPath .githooks
set -euo pipefail

command -v terse >/dev/null 2>&1 || {
  echo "pre-commit: terse is not on PATH; run: dotnet tool install -g terse" >&2
  exit 1
}

status=0
while IFS= read -r -d '' file; do
  git show ":$file" | terse --stdin "$file" || status=1
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.cs')

if [ "$status" -ne 0 ]; then
  echo "pre-commit: comment lint failed; fix the comments above and stage the result" >&2
fi
exit "$status"
